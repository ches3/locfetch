{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/vitest-plugin/types", "vite-plus/client"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "vite.config.ts", "worker-configuration.d.ts"]
}
